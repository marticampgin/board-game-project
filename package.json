{
  "name": "shattered-realm",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Godot 4.7.2 deterministic board-game prototype and development tools",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node tools/setup.mjs",
    "start": "node tools/godot.mjs play",
    "check": "node tools/godot.mjs check",
    "test": "npm run test:headless && npm run test:cli && npm run test:network",
    "test:headless": "node tools/godot.mjs test",
    "test:cli": "node --test tests/integration/cli.test.mjs",
    "test:network": "node --test tests/integration/network.test.mjs",
    "test:network-ui": "node tools/network_ui_smoke.mjs",
    "cli": "node tools/realm.mjs",
    "net": "node tools/network.mjs",
    "build:web": "node tools/build_web.mjs",
    "serve:web": "node tools/serve_web.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
